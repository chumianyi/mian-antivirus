<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".MianApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MianSecurity"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <activity
            android:name=".ui.ShizukuGuideActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.EmergencyActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ProtectActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AppManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ProcessManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.PermissionManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CacheCleanActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ToolboxActivity"
            android:exported="false" />
        <activity
            android:name=".ui.TrafficMonitorActivity"
            android:exported="false" />
        <activity
            android:name=".ui.BatteryMonitorActivity"
            android:exported="false" />
        <activity
            android:name=".ui.WifiCheckActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AppLockActivity"
            android:exported="false" />
        <activity
            android:name=".ui.PrivacyVaultActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LinkCheckerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.NotificationManagerActivity"
            android:exported="false" />
        <activity
            android:name=".ui.DeviceInfoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ApkExtractorActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AdBlockActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LicenseActivity"
            android:exported="false" />
        <activity
            android:name=".ui.FeedbackActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SensorTestActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ScreenTestActivity"
            android:exported="false" />
        <activity
            android:name=".ui.DnsSwitchActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SpeedTestActivity"
            android:exported="false" />

        <service
            android:name=".service.ProtectService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="实时安全守护服务" />
        </service>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
